{
  "name": "promptgen",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.20.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "db:migrate": "pnpm --filter @promptgen/db db:migrate",
    "db:reset": "pnpm --filter @promptgen/db db:reset",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "eval": "pnpm exec promptfoo eval -c packages/prompt-engine/evals/promptfooconfig.yaml --no-cache"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@promptgen/config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "promptfoo": "^0.121.14",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
