{
  "name": "@promptgen/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./seed": "./src/seed.ts",
    "./test-helpers": "./src/test-helpers.ts"
  },
  "scripts": {
