# PromptForge Studio local configuration template.
# Copy values into your local environment file when a later phase needs them.
# Do not commit real secrets.

# Shared runtime mode: development, test, or production.
NODE_ENV=development

# Web app origin used by local callbacks and generated links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API placeholder port for the modular-monolith service.
API_PORT=4000

# Auth session lifetime in seconds. Default is 30 days.
AUTH_SESSION_TTL_SECONDS=2592000

# Phase 1 Google OAuth login config. Never paste real secrets into this template.
GOOGLE_OAUTH_CLIENT_ID=replace-with-local-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-local-secret

# Future Phase 1 data stores. Keep placeholders until the data layer ships.
DATABASE_URL=postgresql://promptforge:promptforge@localhost:5432/promptforge
REDIS_URL=redis://localhost:6379

# Future Phase 2 LLM gateway credential placeholder. Never paste a real key here.
LLM_PROVIDER_API_KEY=replace-with-local-secret

# Phase 6 BYO provider-key encryption secret. Required only when saving or using BYO keys.
BYO_KEY_ENCRYPTION_SECRET=replace-with-local-secret
